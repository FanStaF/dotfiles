#!/usr/bin/env bash

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║     Development Environment Setup     ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
echo ""

# Function to prompt for selection
select_option() {
    local prompt="$1"
    shift
    local options=("$@")

    echo -e "${YELLOW}${prompt}${NC}"
    select opt in "${options[@]}"; do
        if [[ -n "$opt" ]]; then
            echo "$opt"
            return 0
        fi
    done
}

# Function to ask yes/no
ask_yes_no() {
    local prompt="$1"
    local default="${2:-y}"

    if [[ "$default" == "y" ]]; then
        prompt="${prompt} [Y/n]: "
    else
        prompt="${prompt} [y/N]: "
    fi

    read -p "$(echo -e ${YELLOW}${prompt}${NC})" response
    response=${response:-$default}

    [[ "$response" =~ ^[Yy] ]]
}

echo -e "${BLUE}📦 Starting installation...${NC}\n"

# Install Nala wrapper for apt
if ! command -v nala &> /dev/null; then
    echo -e "${GREEN}Installing Nala (better apt frontend)...${NC}"
    sudo apt update
    sudo apt install nala -y
fi

# Core utilities (always install)
echo -e "\n${GREEN}Installing core utilities...${NC}"
sudo nala install -y \
    fzf ripgrep kitty build-essential \
    zsh tmux git curl wget \
    software-properties-common \
    xclip ca-certificates gnupg

# PHP Version Selection
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
if command -v php &> /dev/null; then
    CURRENT_PHP=$(php --version | head -1)
    echo -e "${YELLOW}Current PHP: ${CYAN}${CURRENT_PHP}${NC}\n"
fi
PHP_VERSION=$(select_option "Select PHP version:" "8.3 (Latest stable)" "8.2" "8.1" "8.4 (Beta)" "Skip PHP")

if [[ "$PHP_VERSION" != "Skip PHP" ]]; then
    # Extract version number
    PHP_VER=$(echo "$PHP_VERSION" | grep -o '^[0-9.]*')

    echo -e "${GREEN}Installing PHP ${PHP_VER}...${NC}"

    # Add PHP repository if needed
    if ! apt-cache show php${PHP_VER} &> /dev/null; then
        sudo add-apt-repository ppa:ondrej/php -y
        sudo nala update
    fi

    # Select PHP extensions
    echo -e "\n${YELLOW}Select PHP extensions to install:${NC}"
    if ask_yes_no "Install ALL recommended extensions? (mysql, curl, mbstring, xml, etc.)" "y"; then
        PHP_EXTENSIONS=(
            "php${PHP_VER}" "php${PHP_VER}-cli" "php${PHP_VER}-fpm"
            "php${PHP_VER}-mysql" "php${PHP_VER}-pgsql" "php${PHP_VER}-sqlite3"
            "php${PHP_VER}-curl" "php${PHP_VER}-mbstring" "php${PHP_VER}-xml"
            "php${PHP_VER}-zip" "php${PHP_VER}-gd" "php${PHP_VER}-intl"
            "php${PHP_VER}-bcmath" "php${PHP_VER}-redis"
            "php${PHP_VER}-soap" "php${PHP_VER}-imagick"
        )

        # Ask about xdebug separately (dev-only)
        if ask_yes_no "Install Xdebug? (for debugging)" "y"; then
            PHP_EXTENSIONS+=("php${PHP_VER}-xdebug")
        fi
    else
        # Minimal installation
        PHP_EXTENSIONS=(
            "php${PHP_VER}" "php${PHP_VER}-cli"
            "php${PHP_VER}-mysql" "php${PHP_VER}-curl"
            "php${PHP_VER}-mbstring" "php${PHP_VER}-xml"
            "php${PHP_VER}-zip"
        )
    fi

    # Install extensions (disable exit on error temporarily)
    set +e
    sudo nala install -y "${PHP_EXTENSIONS[@]}" 2>&1 | tee /tmp/php-install.log
    INSTALL_EXIT=$?
    set -e

    if [ $INSTALL_EXIT -eq 0 ]; then
        echo -e "${GREEN}✓ PHP extensions installed${NC}"
    else
        echo -e "${YELLOW}⚠ Some PHP extensions may have failed (this is often OK)${NC}"
        echo -e "  ${CYAN}Log saved to: /tmp/php-install.log${NC}"
    fi

    # Set as default PHP version (won't exit on failure)
    set +e
    sudo update-alternatives --set php /usr/bin/php${PHP_VER} 2>/dev/null
    if [ $? -ne 0 ]; then
        # Try configuring alternatives if set failed
        sudo update-alternatives --install /usr/bin/php php /usr/bin/php${PHP_VER} 100 2>/dev/null
    fi
    set -e
    echo -e "${GREEN}✓ PHP ${PHP_VER} configured as default${NC}"

    echo -e "${GREEN}✓ PHP installation complete${NC}"
    php --version | head -1
fi

# Composer
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
if [[ "$PHP_VERSION" != "Skip PHP" ]]; then
    if command -v composer &> /dev/null; then
        CURRENT_COMPOSER=$(composer --version 2>/dev/null | grep -oP 'Composer version \K[0-9.]+' || echo "unknown")
        echo -e "${YELLOW}Composer installed: ${CYAN}${CURRENT_COMPOSER}${NC}"
        LATEST_COMPOSER=$(curl -s https://api.github.com/repos/composer/composer/releases/latest | grep -oP '"tag_name": "\K[^"]+' || echo "unknown")
        echo -e "${BLUE}Latest available: ${CYAN}${LATEST_COMPOSER}${NC}\n"

        if ask_yes_no "Update Composer?" "n"; then
            echo -e "${GREEN}Updating Composer...${NC}"
            composer self-update
            echo -e "${GREEN}✓ Composer updated${NC}"
        fi
    elif ask_yes_no "Install Composer?" "y"; then
        echo -e "${GREEN}Installing Composer...${NC}"
        EXPECTED_CHECKSUM="$(php -r 'copy("https://composer.github.io/installer.sig", "php://stdout");')"
        php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');"
        ACTUAL_CHECKSUM="$(php -r "echo hash_file('sha384', 'composer-setup.php');")"

        if [ "$EXPECTED_CHECKSUM" != "$ACTUAL_CHECKSUM" ]; then
            echo -e "${RED}ERROR: Invalid installer checksum${NC}"
            rm composer-setup.php
            exit 1
        fi

        php composer-setup.php --quiet
        sudo mv composer.phar /usr/local/bin/composer
        rm composer-setup.php
        echo -e "${GREEN}✓ Composer installed${NC}"
        composer --version
    fi

    # Global Composer packages (ask individually)
    echo -e "\n${YELLOW}Global Composer tools:${NC}"

    # Laravel Installer - Recommended
    if ask_yes_no "Install Laravel Installer? (recommended for creating new projects)" "y"; then
        echo -e "${BLUE}Installing Laravel Installer...${NC}"
        set +e
        composer global require laravel/installer --quiet 2>/dev/null && \
            echo -e "  ${GREEN}✓ Laravel Installer installed${NC}" || \
            echo -e "  ${YELLOW}⚠ Laravel Installer failed${NC}"
        set -e
    fi

    # PHPStan - Usually not needed globally
    echo -e "\n${CYAN}Note: PHPStan is typically used per-project (./vendor/bin/phpstan)${NC}"
    if ask_yes_no "Install PHPStan globally anyway?" "n"; then
        echo -e "${BLUE}Installing PHPStan...${NC}"
        set +e
        composer global require phpstan/phpstan --quiet 2>/dev/null && \
            echo -e "  ${GREEN}✓ PHPStan installed${NC}" || \
            echo -e "  ${YELLOW}⚠ PHPStan failed${NC}"
        set -e
    fi

    # PHP-CS-Fixer - Laravel projects use Pint instead
    echo -e "\n${CYAN}Note: Laravel projects use Pint (better than PHP-CS-Fixer)${NC}"
    if ask_yes_no "Install PHP-CS-Fixer globally?" "n"; then
        echo -e "${BLUE}Installing PHP-CS-Fixer...${NC}"
        set +e
        composer global require friendsofphp/php-cs-fixer --quiet 2>/dev/null && \
            echo -e "  ${GREEN}✓ PHP-CS-Fixer installed${NC}" || \
            echo -e "  ${YELLOW}⚠ PHP-CS-Fixer failed${NC}"
        set -e
    fi
fi

# MySQL Setup
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
MYSQL_CHOICE=$(select_option "MySQL installation:" "Local MySQL Server" "Docker MySQL (recommended)" "Skip")

export INSTALL_MYSQL_LOCAL=""
export INSTALL_MYSQL_DOCKER=""

if [[ "$MYSQL_CHOICE" == "Local MySQL Server" ]]; then
    INSTALL_MYSQL_LOCAL="yes"
    echo -e "${GREEN}Installing MySQL Server...${NC}"
    sudo nala install -y mysql-server mysql-client
    echo -e "${GREEN}✓ MySQL Server installed${NC}"
elif [[ "$MYSQL_CHOICE" == "Docker MySQL (recommended)" ]]; then
    INSTALL_MYSQL_DOCKER="yes"
fi

# Redis Setup
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
REDIS_CHOICE=$(select_option "Redis installation:" "Local Redis Server" "Docker Redis (recommended)" "Skip")

if [[ "$REDIS_CHOICE" == "Local Redis Server" ]]; then
    echo -e "${GREEN}Installing Redis Server...${NC}"
    sudo nala install -y redis-server
    sudo systemctl enable redis-server
    echo -e "${GREEN}✓ Redis Server installed${NC}"
fi

# Docker
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
if command -v docker &> /dev/null; then
    CURRENT_DOCKER=$(docker --version 2>/dev/null | grep -oP 'Docker version \K[0-9.]+' || echo "unknown")
    echo -e "${YELLOW}Docker installed: ${CYAN}${CURRENT_DOCKER}${NC}"

    # Check docker-compose
    if docker compose version &> /dev/null; then
        COMPOSE_VER=$(docker compose version --short 2>/dev/null || echo "installed")
        echo -e "${YELLOW}Docker Compose: ${CYAN}${COMPOSE_VER}${NC}"
    fi

    # Latest available from repo (apt-cache will show available version)
    LATEST_DOCKER=$(apt-cache policy docker-ce 2>/dev/null | grep Candidate | awk '{print $2}' | cut -d':' -f2 | cut -d'-' -f1 || echo "unknown")
    echo -e "${BLUE}Latest available: ${CYAN}${LATEST_DOCKER}${NC}\n"

    if ask_yes_no "Update Docker?" "n"; then
        echo -e "${GREEN}Updating Docker...${NC}"
        sudo nala install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
        echo -e "${GREEN}✓ Docker updated${NC}"
    fi
elif ask_yes_no "Install Docker?" "y"; then
    echo -e "${GREEN}Installing Docker...${NC}"

    # Add Docker's official GPG key
    sudo install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    sudo chmod a+r /etc/apt/keyrings/docker.gpg

    # Add repository
    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
      $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
      sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

    sudo nala update
    sudo nala install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

    # Add user to docker group
    sudo usermod -aG docker $USER

    echo -e "${GREEN}✓ Docker installed${NC}"
    docker --version
    echo -e "${YELLOW}⚠  You'll need to logout/login for Docker group changes to take effect${NC}"
fi

# Node.js with Volta
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
if command -v volta &> /dev/null; then
    echo -e "${YELLOW}Volta installed${NC}"

    if command -v node &> /dev/null; then
        CURRENT_NODE=$(node --version 2>/dev/null)
        echo -e "${YELLOW}Node.js installed: ${CYAN}${CURRENT_NODE}${NC}"

        # Get LTS version info
        LATEST_LTS=$(curl -s https://nodejs.org/dist/index.json | grep -oP '"version":"v\K[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo "unknown")
        echo -e "${BLUE}Latest LTS: ${CYAN}v${LATEST_LTS}${NC}\n"

        if ask_yes_no "Update Node.js to latest LTS?" "n"; then
            echo -e "${GREEN}Updating Node.js...${NC}"
            volta install node@lts
            echo -e "${GREEN}✓ Node.js updated${NC}"
            node --version
        fi
    elif ask_yes_no "Install Node.js LTS via Volta?" "y"; then
        echo -e "${GREEN}Installing Node.js LTS...${NC}"
        volta install node@lts
        echo -e "${GREEN}✓ Node.js installed${NC}"
        node --version
    fi
elif ask_yes_no "Install Node.js via Volta?" "y"; then
    echo -e "${GREEN}Installing Volta...${NC}"
    curl https://get.volta.sh | bash
    export VOLTA_HOME="$HOME/.volta"
    export PATH="$VOLTA_HOME/bin:$PATH"

    if command -v volta &> /dev/null; then
        echo -e "${GREEN}Installing Node.js LTS...${NC}"
        volta install node@lts
        echo -e "${GREEN}✓ Node.js installed via Volta${NC}"
        node --version
    fi
fi

# Neovim
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
if command -v nvim &> /dev/null; then
    CURRENT_NVIM=$(nvim --version 2>/dev/null | head -1 | grep -oP 'NVIM v\K[0-9.]+' || echo "unknown")
    echo -e "${YELLOW}Neovim installed: ${CYAN}v${CURRENT_NVIM}${NC}"

    # Get latest version from GitHub
    LATEST_NVIM=$(curl -s https://api.github.com/repos/neovim/neovim/releases/latest | grep -oP '"tag_name": "v\K[^"]+' || echo "unknown")
    echo -e "${BLUE}Latest available: ${CYAN}v${LATEST_NVIM}${NC}\n"

    if ask_yes_no "Update to latest version?" "n"; then
        echo -e "${GREEN}Updating Neovim...${NC}"
        curl -LO https://github.com/neovim/neovim/releases/latest/download/nvim-linux64.tar.gz
        sudo rm -rf /usr/local/nvim-linux64
        sudo tar -C /usr/local -xzf nvim-linux64.tar.gz
        sudo ln -sf /usr/local/nvim-linux64/bin/nvim /usr/local/bin/nvim
        rm nvim-linux64.tar.gz
        echo -e "${GREEN}✓ Neovim updated${NC}"
        nvim --version | head -1
    fi
elif ask_yes_no "Install Neovim?" "y"; then
    # Show latest version before installing
    LATEST_NVIM=$(curl -s https://api.github.com/repos/neovim/neovim/releases/latest | grep -oP '"tag_name": "v\K[^"]+' || echo "latest")
    echo -e "${BLUE}Installing: ${CYAN}v${LATEST_NVIM}${NC}\n"

    echo -e "${GREEN}Installing Neovim...${NC}"
    curl -LO https://github.com/neovim/neovim/releases/latest/download/nvim-linux64.tar.gz
    sudo rm -rf /usr/local/nvim-linux64
    sudo tar -C /usr/local -xzf nvim-linux64.tar.gz
    sudo ln -sf /usr/local/nvim-linux64/bin/nvim /usr/local/bin/nvim
    rm nvim-linux64.tar.gz
    echo -e "${GREEN}✓ Neovim installed${NC}"
    nvim --version | head -1
fi

# LazyGit
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
if command -v lazygit &> /dev/null; then
    CURRENT_LAZYGIT=$(lazygit --version 2>/dev/null | grep -oP 'version=\K[0-9.]+' || echo "unknown")
    echo -e "${YELLOW}LazyGit installed: ${CYAN}v${CURRENT_LAZYGIT}${NC}"

    LATEST_LAZYGIT=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*' || echo "unknown")
    echo -e "${BLUE}Latest available: ${CYAN}v${LATEST_LAZYGIT}${NC}\n"

    if ask_yes_no "Update LazyGit?" "n"; then
        echo -e "${GREEN}Updating LazyGit...${NC}"
        curl -Lo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LATEST_LAZYGIT}_Linux_x86_64.tar.gz"
        tar xf lazygit.tar.gz lazygit
        sudo install lazygit /usr/local/bin
        rm lazygit lazygit.tar.gz
        echo -e "${GREEN}✓ LazyGit updated${NC}"
    fi
elif ask_yes_no "Install LazyGit?" "y"; then
    LAZYGIT_VERSION=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
    echo -e "${BLUE}Installing: ${CYAN}v${LAZYGIT_VERSION}${NC}\n"

    curl -Lo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz"
    tar xf lazygit.tar.gz lazygit
    sudo install lazygit /usr/local/bin
    rm lazygit lazygit.tar.gz
    echo -e "${GREEN}✓ LazyGit installed${NC}"
    lazygit --version
fi

# Nerd Font
echo -e "\n${MAGENTA}═══════════════════════════════════${NC}"
if fc-list | grep -qi "FiraCode.*Nerd"; then
    echo -e "${YELLOW}FiraCode Nerd Font already installed${NC}"
    if ask_yes_no "Reinstall FiraCode Nerd Font?" "n"; then
        echo -e "${GREEN}Installing FiraCode Nerd Font...${NC}"
        mkdir -p ~/.local/share/fonts
        cd ~/.local/share/fonts
        curl -fLo "FiraCodeNerdFont-Regular.ttf" \
            https://github.com/ryanoasis/nerd-fonts/raw/HEAD/patched-fonts/FiraCode/Regular/FiraCodeNerdFont-Regular.ttf
        curl -fLo "FiraCodeNerdFont-Bold.ttf" \
            https://github.com/ryanoasis/nerd-fonts/raw/HEAD/patched-fonts/FiraCode/Bold/FiraCodeNerdFont-Bold.ttf
        fc-cache -fv > /dev/null 2>&1
        cd - > /dev/null
        echo -e "${GREEN}✓ FiraCode Nerd Font installed${NC}"
    fi
elif ask_yes_no "Install FiraCode Nerd Font?" "y"; then
    echo -e "${GREEN}Installing FiraCode Nerd Font...${NC}"
    mkdir -p ~/.local/share/fonts
    cd ~/.local/share/fonts
    curl -fLo "FiraCodeNerdFont-Regular.ttf" \
        https://github.com/ryanoasis/nerd-fonts/raw/HEAD/patched-fonts/FiraCode/Regular/FiraCodeNerdFont-Regular.ttf
    curl -fLo "FiraCodeNerdFont-Bold.ttf" \
        https://github.com/ryanoasis/nerd-fonts/raw/HEAD/patched-fonts/FiraCode/Bold/FiraCodeNerdFont-Bold.ttf
    fc-cache -fv > /dev/null 2>&1
    cd - > /dev/null
    echo -e "${GREEN}✓ FiraCode Nerd Font installed${NC}"
fi

echo -e "\n${CYAN}════════════════════════════════════════${NC}"
echo -e "${GREEN}✅ Installation complete!${NC}"
echo -e "${CYAN}════════════════════════════════════════${NC}"

# Post-install instructions
echo -e "\n${YELLOW}Next steps:${NC}"
echo -e "1. Run: ${CYAN}./install${NC} (to symlink dotfiles)"

if [[ "$INSTALL_MYSQL_LOCAL" == "yes" ]]; then
    echo -e "2. Run: ${CYAN}./scripts/bootstrap-mysql${NC} (to configure MySQL)"
fi

if [[ "$INSTALL_MYSQL_DOCKER" == "yes" ]]; then
    echo -e "2. Run: ${CYAN}docker compose up -d${NC} (see docker-compose.yml)"
fi

echo -e "3. Run: ${CYAN}exec zsh${NC} (restart shell)"
echo -e "4. Run: ${CYAN}nvim +Lazy${NC} (install Neovim plugins)"
echo -e "5. Run: ${CYAN}./scripts/verify-setup${NC} (verify installation)"

if groups | grep -q docker; then
    echo ""
else
    echo -e "\n${YELLOW}⚠  Logout and login again for Docker group permissions${NC}"
fi

echo ""
