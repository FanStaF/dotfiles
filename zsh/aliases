
################################
# alias
################################


alias hg='history | grep -i'

alias changephp='sudo update-alternatives --config php'

alias vim9='/snap/nvim/current/usr/bin/nvim'
# php aliases
alias ide-helper='php artisan ide-helper:generate && php artisan ide-helper:meta && php artisan ide-helper:eloquent'
alias art='php artisan'
alias art7='php7.3 artisan'
alias serve='php artisan serve'
alias serve7='php7.3 artisan serve'
alias migrate='php artisan migrate --force'
alias tinker='php artisan tinker'
alias pt='phpunit --colors --bootstrap'
alias pint='php ./vendor/bin/pint --dirty'

# Git aliases
alias G='git'
alias GS='git status'
alias GF='git fetch'
alias GC='git commit'

alias mailhog='docker run -p 8025:8025 -p 1025:1025 mailhog/mailhog'
alias kali='docker run --net=host --rm -ti kali'

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi
