#!/usr/bin/env zsh

# Exit on error
set -e

# Get dotfiles directory (zsh-compatible)
DOTFILES=$(cd $(dirname "${(%):-%N}") && pwd)

echo "📦 Installing dotfiles from: $DOTFILES"

# Zsh configuration
ln -sf $DOTFILES/zsh/zshrc $HOME/.zshrc
ln -sf $DOTFILES/zsh/zshenv $HOME/.zshenv

# Git configuration
ln -sf $DOTFILES/git/gitconfig $HOME/.gitconfig
ln -sf $DOTFILES/git/gitignore_global $HOME/.gitignore_global

# Create directories
mkdir -p $HOME/.config
mkdir -p $HOME/.local/bin

# Terminal emulator
ln -sf $DOTFILES/kitty $HOME/.config/kitty

# Tmux
ln -sf $DOTFILES/tmux/tmux.conf $HOME/.tmux.conf

# Scripts
ln -sf $DOTFILES/scripts/t $HOME/.local/bin/t
ln -sf $DOTFILES/scripts/goL $HOME/.local/bin/goL
ln -sf $DOTFILES/scripts/goD $HOME/.local/bin/goD
# Kali: Create scripts/kali - see zsh/aliases lines 30-32 for examples
ln -sf $DOTFILES/scripts/kali $HOME/.local/bin/kali

# PHPStorm integration
ln -sf $DOTFILES/scripts/phpstorm-url-handler $HOME/.local/bin/phpstorm-url-handler
$DOTFILES/scripts/setup-phpstorm-nvim-handler || echo "⚠️  phpstorm-nvim handler setup failed"

# Neovim
ln -sf $DOTFILES/nvim $HOME/.config/nvim

echo "✅ Dotfiles installed successfully!"
echo "🔄 Restart your shell or run: source ~/.zshrc"
