#!/usr/bin/env bash

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║    Development Setup Verification     ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════╝${NC}\n"

ERRORS=0
WARNINGS=0

# Function to check if command exists
check_command() {
    local cmd="$1"
    local name="${2:-$1}"
    local required="${3:-yes}"

    if command -v "$cmd" &> /dev/null; then
        local version=$(eval "$cmd --version 2>/dev/null | head -1" || echo "")
        echo -e "  ${GREEN}✓${NC} $name"
        if [[ -n "$version" ]]; then
            echo -e "    ${CYAN}→${NC} $version"
        fi
        return 0
    else
        if [[ "$required" == "yes" ]]; then
            echo -e "  ${RED}✗${NC} $name ${RED}(not found)${NC}"
            ((ERRORS++))
        else
            echo -e "  ${YELLOW}⊘${NC} $name ${YELLOW}(optional, not installed)${NC}"
            ((WARNINGS++))
        fi
        return 1
    fi
}

# Function to check file exists
check_file() {
    local file="$1"
    local name="$2"

    if [[ -f "$file" ]] || [[ -L "$file" ]]; then
        echo -e "  ${GREEN}✓${NC} $name"
        return 0
    else
        echo -e "  ${RED}✗${NC} $name ${RED}(not found)${NC}"
        ((ERRORS++))
        return 1
    fi
}

# Function to check directory exists
check_dir() {
    local dir="$1"
    local name="$2"

    if [[ -d "$dir" ]] || [[ -L "$dir" ]]; then
        echo -e "  ${GREEN}✓${NC} $name"
        return 0
    else
        echo -e "  ${RED}✗${NC} $name ${RED}(not found)${NC}"
        ((ERRORS++))
        return 1
    fi
}

echo -e "${BLUE}Core Tools:${NC}"
check_command zsh "Zsh"
check_command tmux "Tmux"
check_command nvim "Neovim"
check_command fzf "FZF"
check_command rg "Ripgrep"
check_command git "Git"

echo -e "\n${BLUE}Shell Configuration:${NC}"
check_file ~/.zshrc "~/.zshrc"
check_file ~/.zshenv "~/.zshenv"

if [[ "$SHELL" == *"zsh"* ]]; then
    echo -e "  ${GREEN}✓${NC} Default shell: Zsh"
else
    echo -e "  ${YELLOW}⚠${NC} Default shell: $SHELL ${YELLOW}(should be zsh)${NC}"
    echo -e "    ${CYAN}→${NC} Run: chsh -s \$(which zsh)"
    ((WARNINGS++))
fi

echo -e "\n${BLUE}Terminal:${NC}"
check_command kitty "Kitty" "no"
check_dir ~/.config/kitty "Kitty config"

echo -e "\n${BLUE}Tmux:${NC}"
check_file ~/.tmux.conf "~/.tmux.conf"
check_command t "Tmux session manager (t)"

echo -e "\n${BLUE}Neovim:${NC}"
check_dir ~/.config/nvim "Neovim config"
check_dir ~/.config/nvim/lua/plugins "Plugin configs"

if command -v nvim &> /dev/null; then
    if nvim --version | grep -q "NVIM v0.1[0-9]"; then
        echo -e "  ${GREEN}✓${NC} Neovim version 0.10+"
    else
        echo -e "  ${YELLOW}⚠${NC} Neovim version $(nvim --version | head -1)"
        echo -e "    ${CYAN}→${NC} Recommended: 0.10+ for native LSP"
        ((WARNINGS++))
    fi
fi

echo -e "\n${BLUE}PHP Environment:${NC}"
if check_command php "PHP"; then
    # Check PHP extensions (using modern names)
    REQUIRED_EXTS=("curl" "mbstring" "xml" "zip")
    MISSING_EXTS=()

    for ext in "${REQUIRED_EXTS[@]}"; do
        if php -m 2>/dev/null | grep -qi "^${ext}$"; then
            echo -e "  ${GREEN}✓${NC} PHP extension: $ext"
        else
            echo -e "  ${RED}✗${NC} PHP extension: $ext ${RED}(missing)${NC}"
            MISSING_EXTS+=("$ext")
            ((ERRORS++))
        fi
    done

    # Check MySQL extensions (mysqli or pdo_mysql)
    if php -m 2>/dev/null | grep -qiE "^(mysqli|pdo_mysql)$"; then
        echo -e "  ${GREEN}✓${NC} PHP extension: MySQL (mysqli/pdo_mysql)"
    else
        echo -e "  ${RED}✗${NC} PHP extension: MySQL ${RED}(missing mysqli/pdo_mysql)${NC}"
        MISSING_EXTS+=("mysqli")
        ((ERRORS++))
    fi

    # Optional extensions
    OPTIONAL_EXTS=("redis" "xdebug" "imagick")
    for ext in "${OPTIONAL_EXTS[@]}"; do
        if php -m 2>/dev/null | grep -qi "^${ext}$"; then
            echo -e "  ${GREEN}✓${NC} PHP extension: $ext (optional)"
        fi
    done
fi

check_command composer "Composer"

if command -v composer &> /dev/null; then
    GLOBAL_BIN="$HOME/.composer/vendor/bin:$HOME/.config/composer/vendor/bin"
    if [[ ":$PATH:" == *":$HOME/.composer/vendor/bin:"* ]] || [[ ":$PATH:" == *":$HOME/.config/composer/vendor/bin:"* ]]; then
        echo -e "  ${GREEN}✓${NC} Composer global bin in PATH"
    else
        echo -e "  ${YELLOW}⚠${NC} Composer global bin not in PATH"
        ((WARNINGS++))
    fi
fi

echo -e "\n${BLUE}Database:${NC}"
if check_command mysql "MySQL Client"; then
    # Check if MySQL server is running
    if sudo systemctl is-active --quiet mysql 2>/dev/null; then
        echo -e "  ${GREEN}✓${NC} MySQL service running"

        # Test connection
        if mysql -uroot -ppassword -e "SELECT 1" &> /dev/null; then
            echo -e "  ${GREEN}✓${NC} MySQL connection (root/password)"

            # Check databases
            if mysql -uroot -ppassword -e "USE development" &> /dev/null; then
                echo -e "  ${GREEN}✓${NC} Database: development"
            else
                echo -e "  ${YELLOW}⊘${NC} Database: development (not created)"
                ((WARNINGS++))
            fi

            if mysql -uroot -ppassword -e "USE testing" &> /dev/null; then
                echo -e "  ${GREEN}✓${NC} Database: testing"
            else
                echo -e "  ${YELLOW}⊘${NC} Database: testing (not created)"
                ((WARNINGS++))
            fi
        else
            echo -e "  ${YELLOW}⚠${NC} Cannot connect with root/password"
            echo -e "    ${CYAN}→${NC} Run: ./scripts/bootstrap-mysql"
            ((WARNINGS++))
        fi
    elif command -v docker &> /dev/null && docker ps 2>/dev/null | grep -q mysql; then
        echo -e "  ${GREEN}✓${NC} MySQL running in Docker"
    else
        echo -e "  ${YELLOW}⊘${NC} MySQL service not running"
        ((WARNINGS++))
    fi
fi

echo -e "\n${BLUE}Containers:${NC}"
check_command docker "Docker" "no"

if command -v docker &> /dev/null; then
    if docker ps &> /dev/null; then
        echo -e "  ${GREEN}✓${NC} Docker daemon accessible"
    else
        echo -e "  ${YELLOW}⚠${NC} Docker daemon not accessible"
        echo -e "    ${CYAN}→${NC} Check: groups (should include 'docker')"
        echo -e "    ${CYAN}→${NC} Or run: sudo usermod -aG docker $USER && logout"
        ((WARNINGS++))
    fi

    if command -v docker-compose &> /dev/null || docker compose version &> /dev/null 2>&1; then
        echo -e "  ${GREEN}✓${NC} Docker Compose"
    fi
fi

echo -e "\n${BLUE}Node.js Environment:${NC}"
if check_command volta "Volta" "no"; then
    check_command node "Node.js"
    check_command npm "NPM"
else
    check_command node "Node.js" "no"
    check_command npm "NPM" "no"
fi

# Check if LSP servers are available (Mason installs to ~/.local/share/nvim/mason)
echo -e "\n${BLUE}LSP Servers (for Neovim):${NC}"

MASON_BIN="$HOME/.local/share/nvim/mason/bin"
MASON_PACKAGES="$HOME/.local/share/nvim/mason/packages"
MISSING_LSPS=0

# Function to check Mason-installed package
check_mason_lsp() {
    local bin_name="$1"
    local package_name="$2"
    local display_name="$3"

    if [[ -f "$MASON_BIN/$bin_name" ]] || [[ -d "$MASON_PACKAGES/$package_name" ]]; then
        echo -e "  ${GREEN}✓${NC} $display_name"
        return 0
    else
        echo -e "  ${YELLOW}⊘${NC} $display_name ${YELLOW}(not installed via Mason)${NC}"
        ((MISSING_LSPS++))
        ((WARNINGS++))
        return 1
    fi
}

if [[ -d "$MASON_PACKAGES" ]]; then
    check_mason_lsp "intelephense" "intelephense" "Intelephense (PHP)"
    check_mason_lsp "tailwindcss-language-server" "tailwindcss-language-server" "Tailwind CSS"
    check_mason_lsp "lua-language-server" "lua-language-server" "Lua LS"

    # List other installed LSPs
    if [[ -d "$MASON_PACKAGES" ]]; then
        LSP_COUNT=$(ls -1 "$MASON_PACKAGES" 2>/dev/null | wc -l)
        if [[ $LSP_COUNT -gt 3 ]]; then
            echo -e "  ${CYAN}ℹ${NC}  Total Mason packages: ${CYAN}${LSP_COUNT}${NC}"
        fi
    fi

    # Only show install message if LSPs are actually missing
    if [[ $MISSING_LSPS -gt 0 ]]; then
        echo -e "  ${YELLOW}ℹ${NC}  Install missing LSPs: ${CYAN}nvim${NC} then ${CYAN}:MasonInstall intelephense tailwindcss-language-server${NC}"
    fi
else
    echo -e "  ${YELLOW}⊘${NC} Mason not initialized"
    echo -e "    ${CYAN}→${NC} Open Neovim to initialize: ${CYAN}nvim${NC}"
    ((WARNINGS++))
fi

echo -e "\n${BLUE}Git Configuration:${NC}"
check_file ~/.gitconfig "~/.gitconfig"
check_file ~/.gitignore_global "~/.gitignore_global"

if git config --global user.name &> /dev/null && git config --global user.email &> /dev/null; then
    echo -e "  ${GREEN}✓${NC} Git user configured"
    echo -e "    ${CYAN}→${NC} $(git config --global user.name) <$(git config --global user.email)>"
else
    echo -e "  ${YELLOW}⚠${NC} Git user not configured"
    echo -e "    ${CYAN}→${NC} Run: git config --global user.name \"Your Name\""
    echo -e "    ${CYAN}→${NC} Run: git config --global user.email \"your@email.com\""
    ((WARNINGS++))
fi

echo -e "\n${BLUE}Utilities:${NC}"
check_command lazygit "LazyGit" "no"
check_command batcat "Bat (better cat)" "no"
check_command gh "GitHub CLI (gh)" "no"
check_file ~/.local/bin/goL "Theme switcher (goL/goD)"

# Font check
echo -e "\n${BLUE}Fonts:${NC}"
if fc-list | grep -qi "Nerd"; then
    # Detect which Nerd Font is installed
    NERD_FONT=$(fc-list | grep -i "Nerd" | head -1 | grep -oP '[\w]+Nerd' | head -1 || echo "Nerd Font")
    echo -e "  ${GREEN}✓${NC} Nerd Font installed"

    # Show which font family
    if fc-list | grep -qi "JetBrains.*Nerd"; then
        echo -e "    ${CYAN}→${NC} JetBrainsMono Nerd Font"
    elif fc-list | grep -qi "FiraCode.*Nerd"; then
        echo -e "    ${CYAN}→${NC} FiraCode Nerd Font"
        echo -e "    ${YELLOW}⚠${NC} kitty.conf expects JetBrains Mono — consider reinstalling via ./installSoftware"
        ((WARNINGS++))
    elif fc-list | grep -qi "Hack.*Nerd"; then
        echo -e "    ${CYAN}→${NC} Hack Nerd Font"
    fi
else
    echo -e "  ${YELLOW}⚠${NC} Nerd Font not found"
    echo -e "    ${CYAN}→${NC} Required for icons in Neovim/Tmux"
    echo -e "    ${CYAN}→${NC} Run: ./installSoftware (select JetBrains Mono Nerd Font)"
    ((WARNINGS++))
fi

# Summary
echo -e "\n${CYAN}════════════════════════════════════════${NC}"

if [[ $ERRORS -eq 0 ]] && [[ $WARNINGS -eq 0 ]]; then
    echo -e "${GREEN}✅ Perfect! Everything is set up correctly.${NC}"
elif [[ $ERRORS -eq 0 ]]; then
    echo -e "${YELLOW}✓ Setup complete with $WARNINGS warning(s).${NC}"
    echo -e "${YELLOW}  Optional components or minor issues detected.${NC}"
else
    echo -e "${RED}✗ Setup incomplete: $ERRORS error(s), $WARNINGS warning(s).${NC}"
    echo -e "${YELLOW}  Run the suggested commands above to fix issues.${NC}"
fi

echo -e "${CYAN}════════════════════════════════════════${NC}\n"

exit $ERRORS
