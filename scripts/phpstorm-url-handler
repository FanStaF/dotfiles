#!/usr/bin/env zsh
# open PhpStorm URLs inside running Neovim (in tmux session if available)

url="$1"

# Extract file and line
file=$(echo "$url" | sed -E 's/.*file=([^&]+).*/\1/' | sed 's/%2F/\//g')
line=$(echo "$url" | sed -E 's/.*line=([0-9]+).*/\1/')

# Auto-discover running nvim socket (most recent one)
find_nvim_socket() {
  # Check common socket locations (nvim auto-creates these)
  local socket_dirs=(
    "/run/user/$UID"
    "/tmp/nvim$USER"
    "/tmp"
  )

  for dir in "${socket_dirs[@]}"; do
    if [ -d "$dir" ]; then
      # Find most recently modified nvim socket
      local socket=$(find "$dir" -maxdepth 1 -type s -name "nvim*.0" 2>/dev/null | head -n1)
      if [ -n "$socket" ]; then
        echo "$socket"
        return 0
      fi
    fi
  done

  return 1
}

SOCKET=$(find_nvim_socket)

# If a socket exists, send to the running Neovim instance
if [ -n "$SOCKET" ] && [ -S "$SOCKET" ]; then
  nvim --server "$SOCKET" --remote-send "<Cmd>edit +$line $file<CR>"
  # Optional: focus the tmux window running Neovim
  if [ -n "$TMUX" ]; then
    tmux select-window -t "$(tmux list-windows -F '#{window_index}:#{window_name}' | grep -i nvim | cut -d: -f1 | head -n1)" 2>/dev/null || true
  fi
else
  # No socket found — open a new Neovim session as fallback
  nvim +"$line" "$file"
fi
