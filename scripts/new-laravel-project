#!/usr/bin/env bash

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# Check if composer is installed
if ! command -v composer &> /dev/null; then
    echo -e "${RED}❌ Composer is not installed${NC}"
    exit 1
fi

# Get project name
if [[ -z "$1" ]]; then
    echo -e "${YELLOW}Usage: $0 <project-name> [directory]${NC}"
    echo -e "Example: $0 my-app"
    echo -e "Example: $0 my-app ~/projects"
    exit 1
fi

PROJECT_NAME="$1"
TARGET_DIR="${2:-.}"
FULL_PATH="$TARGET_DIR/$PROJECT_NAME"

echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║     Laravel Project Bootstrap          ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════╝${NC}\n"

echo -e "${BLUE}📦 Creating Laravel project: ${CYAN}$PROJECT_NAME${NC}\n"

# Create project
if [[ -d "$FULL_PATH" ]]; then
    echo -e "${RED}❌ Directory already exists: $FULL_PATH${NC}"
    exit 1
fi

cd "$TARGET_DIR"
composer create-project laravel/laravel "$PROJECT_NAME" --no-interaction

cd "$PROJECT_NAME"

echo -e "\n${GREEN}✓ Laravel installed${NC}\n"

# Setup environment
echo -e "${YELLOW}⚙️  Configuring environment...${NC}"

# Update .env file with our standard settings
if [[ -f .env ]]; then
    # Database configuration
    sed -i 's/DB_CONNECTION=.*/DB_CONNECTION=mysql/' .env
    sed -i 's/DB_HOST=.*/DB_HOST=127.0.0.1/' .env
    sed -i 's/DB_PORT=.*/DB_PORT=3306/' .env
    sed -i 's/DB_DATABASE=.*/DB_DATABASE=development/' .env
    sed -i 's/DB_USERNAME=.*/DB_USERNAME=root/' .env
    sed -i 's/DB_PASSWORD=.*/DB_PASSWORD=password/' .env

    # Cache/Session/Queue (using Redis if available)
    if command -v redis-cli &> /dev/null || docker ps 2>/dev/null | grep -q redis; then
        sed -i 's/CACHE_STORE=.*/CACHE_STORE=redis/' .env
        sed -i 's/SESSION_DRIVER=.*/SESSION_DRIVER=redis/' .env
        sed -i 's/QUEUE_CONNECTION=.*/QUEUE_CONNECTION=redis/' .env
    fi

    # Mail (MailHog)
    sed -i 's/MAIL_MAILER=.*/MAIL_MAILER=smtp/' .env
    sed -i 's/MAIL_HOST=.*/MAIL_HOST=localhost/' .env
    sed -i 's/MAIL_PORT=.*/MAIL_PORT=1025/' .env

    echo -e "${GREEN}✓ Environment configured${NC}"
else
    echo -e "${YELLOW}⚠  No .env file found${NC}"
fi

# Generate app key (if not already done)
php artisan key:generate --ansi

# Ask about dev dependencies
echo -e "\n${YELLOW}📚 Development tools:${NC}"
echo "Install development dependencies?"
echo "  1) Full stack (PHPStan, Pint, Pest, IDE Helper)"
echo "  2) Minimal (Pint only)"
echo "  3) Skip"
read -p "Choice [1]: " DEV_CHOICE
DEV_CHOICE=${DEV_CHOICE:-1}

if [[ "$DEV_CHOICE" == "1" ]]; then
    echo -e "\n${BLUE}Installing development tools...${NC}"

    composer require --dev phpstan/phpstan --no-interaction
    composer require --dev laravel/pint --no-interaction
    composer require --dev pestphp/pest --no-interaction
    composer require --dev pestphp/pest-plugin-laravel --no-interaction
    composer require --dev barryvdh/laravel-ide-helper --no-interaction

    # Initialize Pest
    php artisan pest:install --no-interaction 2>/dev/null || true

    # Generate IDE helper files
    php artisan ide-helper:generate --no-interaction
    php artisan ide-helper:models --no-interaction --nowrite
    php artisan ide-helper:meta --no-interaction

    # Create phpstan.neon if it doesn't exist
    if [[ ! -f phpstan.neon ]]; then
        cat > phpstan.neon <<'EOL'
includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - routes
    excludePaths:
        - vendor
    ignoreErrors:
EOL
        echo -e "${GREEN}✓ Created phpstan.neon${NC}"
    fi

    echo -e "${GREEN}✓ Development tools installed${NC}"

elif [[ "$DEV_CHOICE" == "2" ]]; then
    composer require --dev laravel/pint --no-interaction
    echo -e "${GREEN}✓ Laravel Pint installed${NC}"
fi

# Create database if it doesn't exist
echo -e "\n${YELLOW}🗄️  Database setup:${NC}"
if mysql -uroot -ppassword -e "CREATE DATABASE IF NOT EXISTS development CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci" 2>/dev/null; then
    echo -e "${GREEN}✓ Database 'development' ready${NC}"

    # Run migrations
    if php artisan migrate --no-interaction 2>/dev/null; then
        echo -e "${GREEN}✓ Migrations completed${NC}"
    else
        echo -e "${YELLOW}⚠  Could not run migrations${NC}"
    fi
else
    echo -e "${YELLOW}⚠  Could not create database${NC}"
    echo -e "  Run: ${CYAN}./scripts/bootstrap-mysql${NC}"
fi

# Create .arduino-fqbn if needed (for Arduino projects)
# This is a placeholder - uncomment if you work with Arduino
# echo "arduino:esp32:esp32" > .arduino-fqbn

# Git initialization
if [[ ! -d .git ]]; then
    echo -e "\n${YELLOW}📝 Initializing git repository...${NC}"
    git init
    git add .
    git commit -m "Initial commit - Laravel project setup" --quiet
    echo -e "${GREEN}✓ Git repository initialized${NC}"
fi

# Create useful scripts directory
mkdir -p scripts
cat > scripts/dev <<'EOL'
#!/usr/bin/env bash
# Start development environment
php artisan serve &
php artisan queue:work &
wait
EOL
chmod +x scripts/dev

echo -e "\n${CYAN}════════════════════════════════════════${NC}"
echo -e "${GREEN}✅ Project ready!${NC}"
echo -e "${CYAN}════════════════════════════════════════${NC}\n"

echo -e "${YELLOW}Quick start:${NC}"
echo -e "  ${CYAN}cd $PROJECT_NAME${NC}"
echo -e "  ${CYAN}php artisan serve${NC}"
echo -e ""
echo -e "${YELLOW}Development:${NC}"
echo -e "  ${CYAN}./vendor/bin/pest${NC}          - Run tests"
echo -e "  ${CYAN}./vendor/bin/pint${NC}          - Format code"
echo -e "  ${CYAN}./vendor/bin/phpstan${NC}       - Static analysis"
echo -e "  ${CYAN}php artisan tinker${NC}         - REPL"
echo -e ""
echo -e "${YELLOW}Project path:${NC}"
echo -e "  ${CYAN}$(pwd)${NC}\n"

# Open in Neovim if desired
if command -v nvim &> /dev/null; then
    read -p "$(echo -e ${YELLOW}Open in Neovim? [y/N]:${NC} )" OPEN_NVIM
    if [[ "$OPEN_NVIM" =~ ^[Yy] ]]; then
        nvim .
    fi
fi
