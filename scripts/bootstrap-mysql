#!/usr/bin/env bash

set -e

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${CYAN}═══════════════════════════════════════${NC}"
echo -e "${CYAN}      MySQL Database Setup${NC}"
echo -e "${CYAN}═══════════════════════════════════════${NC}\n"

# Check if MySQL is installed
if ! command -v mysql &> /dev/null; then
    echo -e "${RED}❌ MySQL is not installed${NC}"
    echo -e "Run: ${CYAN}./installSoftware${NC} and select MySQL"
    exit 1
fi

# Check if MySQL is running
if ! sudo systemctl is-active --quiet mysql; then
    echo -e "${YELLOW}Starting MySQL service...${NC}"
    sudo systemctl start mysql
    sudo systemctl enable mysql
fi

echo -e "${GREEN}🗄️  Configuring MySQL with root/password credentials...${NC}\n"

# Configure MySQL root user with password
# Using --connect-expired-password in case the root password is expired
sudo mysql --connect-expired-password <<EOF
-- Set root password to 'password'
ALTER USER 'root'@'localhost' IDENTIFIED WITH mysql_native_password BY 'password';

-- Remove anonymous users
DELETE FROM mysql.user WHERE User='';

-- Remove remote root access (keep only localhost)
DELETE FROM mysql.user WHERE User='root' AND Host NOT IN ('localhost', '127.0.0.1', '::1');

-- Drop test database if exists
DROP DATABASE IF EXISTS test;
DELETE FROM mysql.db WHERE Db='test' OR Db='test\\_%';

-- Apply changes
FLUSH PRIVILEGES;
EOF

echo -e "${GREEN}✓ MySQL security configured${NC}\n"

# Create development databases
echo -e "${YELLOW}Creating development databases...${NC}"

mysql -uroot -ppassword <<EOF
CREATE DATABASE IF NOT EXISTS development CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE DATABASE IF NOT EXISTS testing CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
FLUSH PRIVILEGES;
EOF

echo -e "${GREEN}✓ Databases created${NC}\n"

# Verify connection
echo -e "${YELLOW}Verifying MySQL connection...${NC}"
if mysql -uroot -ppassword -e "SELECT VERSION();" > /dev/null 2>&1; then
    echo -e "${GREEN}✓ MySQL connection successful${NC}\n"
else
    echo -e "${RED}❌ MySQL connection failed${NC}\n"
    exit 1
fi

# Display summary
echo -e "${CYAN}════════════════════════════════════════${NC}"
echo -e "${GREEN}✅ MySQL setup complete!${NC}"
echo -e "${CYAN}════════════════════════════════════════${NC}\n"

echo -e "${YELLOW}MySQL Credentials:${NC}"
echo -e "  Host:     ${CYAN}127.0.0.1${NC}"
echo -e "  Port:     ${CYAN}3306${NC}"
echo -e "  Username: ${CYAN}root${NC}"
echo -e "  Password: ${CYAN}password${NC}\n"

echo -e "${YELLOW}Databases:${NC}"
echo -e "  ${CYAN}development${NC} - For development work"
echo -e "  ${CYAN}testing${NC}     - For running tests\n"

echo -e "${YELLOW}Test connection:${NC}"
echo -e "  ${CYAN}mysql -uroot -ppassword${NC}"
echo -e "  ${CYAN}mysql -uroot -ppassword development${NC}\n"

echo -e "${YELLOW}.env configuration for Laravel:${NC}"
echo -e "  ${CYAN}DB_CONNECTION=mysql${NC}"
echo -e "  ${CYAN}DB_HOST=127.0.0.1${NC}"
echo -e "  ${CYAN}DB_PORT=3306${NC}"
echo -e "  ${CYAN}DB_DATABASE=development${NC}"
echo -e "  ${CYAN}DB_USERNAME=root${NC}"
echo -e "  ${CYAN}DB_PASSWORD=password${NC}\n"
